+    /// Wake a blocking console read without requiring a terminal reply or key.
+    pub fn wakeInput(_: *WindowsTty) !void {
+        const handle = CreateFileW(std.unicode.utf8ToUtf16LeStringLiteral("CONIN$"), 0x40000000, 3, null, 3, 0, null);
+        if (handle == windows.INVALID_HANDLE_VALUE) return windows.unexpectedError(windows.GetLastError());
+        defer windows.CloseHandle(handle);
+        var record: INPUT_RECORD = .{ .EventType = 0x0010, .Event = .{ .FocusEvent = .{ .bSetFocus = .TRUE } } };
+        var written: windows.DWORD = 0;
+        if (!WriteConsoleInputW(handle, &record, 1, &written).toBool()) return windows.unexpectedError(windows.GetLastError());
+        if (written != 1) return error.Unexpected;
+    }
