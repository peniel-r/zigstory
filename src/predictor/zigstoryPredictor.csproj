<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>zigstoryPredictor</RootNamespace>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- PowerShell supplies this assembly at runtime; do not ship a second shell SDK. -->
    <PackageReference Include="System.Management.Automation" Version="7.4.6" PrivateAssets="all" IncludeAssets="compile;build;buildtransitive;analyzers" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
  </ItemGroup>

  <Target Name="CopyNativeSqlite" AfterTargets="Publish">
    <Copy SourceFiles="$(PublishDir)runtimes\win-x64\native\e_sqlite3.dll" DestinationFolder="$(PublishDir)" Condition="Exists('$(PublishDir)runtimes\win-x64\native\e_sqlite3.dll')" />
  </Target>

</Project>
